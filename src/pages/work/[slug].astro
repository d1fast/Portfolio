---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Case from '../../components/Case.astro';
export async function getStaticPaths() {
  const entries = await getCollection('work', (e) => e.id.endsWith('/ru') && !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id.split('/')[0] }, props: { entry } }));
}
const { entry } = Astro.props;
const { slug } = Astro.params;
---
<Base lang="ru" path={`/work/${slug}/`} title={`${entry.data.title}: ${entry.data.subtitle}`} description={entry.data.subtitle} ogImage={entry.data.cover} theme="dark">
  <Case lang="ru" entry={entry} slug={slug} />
</Base>
