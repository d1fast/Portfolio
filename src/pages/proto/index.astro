---
// Временная страница с тремя вариантами первого экрана. Удаляется после выбора.
import '../../styles/fonts.generated.css';
import { t } from '../../i18n';
const d = t('ru');
const brief = d.hero.brief;
const nav = [d.nav.about, d.nav.services, d.nav.works, d.nav.process, d.nav.contacts];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>Прототипы первого экрана</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <div id="stage"></div>

    <nav class="proto-picker" aria-label="Prototype variants">
      <span class="proto-picker-highlight" aria-hidden="true"></span>
      <button class="proto-picker-item" data-active aria-current="true">Чертёж</button>
      <button class="proto-picker-item">Схема</button>
      <button class="proto-picker-item">Линия</button>
      <span class="proto-picker-divider" aria-hidden="true"></span>
      <button class="proto-picker-item proto-picker-replay" aria-label="Replay animation (R)">↻</button>
    </nav>

    <!-- ===================== Вариант 1. Чертёж ===================== -->
    <template id="tpl-1">
      <section class="v1 hero" data-variant="1">
        <header class="v1-top">
          <a class="v1-logo" href="#">{d.hero.nick}</a>
          <nav class="v1-nav">{nav.map((n) => <a href="#">{n}</a>)}</nav>
          <a class="v1-lang" href="#" title={d.nav.langSwitchTitle}>{d.nav.langSwitch}</a>
        </header>
        <div class="v1-frame" aria-hidden="true"></div>
        <div class="v1-req brief-box" aria-hidden="true">
          <div class="v1-req-title">{d.hero.fileName}</div>
          <div class="brief-lines" data-lines></div>
        </div>
        <div class="v1-final hero-final">
          <h1 class="v1-name" data-target="name"><span class="v1-w">Савелий</span> <span class="v1-w">Лопатин</span></h1>
          <div class="v1-dim v1-dim-h" aria-hidden="true"><i></i><b data-dim="w">0 px</b></div>
          <div class="v1-dim v1-dim-v" aria-hidden="true"><i></i><b data-dim="h">0 px</b></div>
          <p class="v1-tag" data-target="do">{d.hero.tagline}</p>
          <p class="v1-meta" data-target="who">Москва, работаю удалённо. Отвечаю в тот же день.</p>
          <div class="v1-cta">
            <a class="v1-btn v1-btn-p" href="#" data-target="contact">{d.hero.ctaTelegram}</a>
            <a class="v1-btn" href="#" data-target="main">{d.hero.ctaWorks}</a>
          </div>
          <div class="v1-callout" aria-hidden="true"><span>{d.hero.nick}</span></div>
        </div>
        <div class="v1-stamp" aria-hidden="true">
          <div class="v1-stamp-row"><span>Разраб.</span><b>Лопатин С.</b></div>
          <div class="v1-stamp-row"><span>Проект</span><b>d1fast.github.io</b></div>
          <div class="v1-stamp-row"><span>Лист</span><b>1</b><span>Листов</span><b>6</b></div>
          <div class="v1-stamp-row"><span>Дата</span><b>10.2026</b></div>
        </div>
        <button class="skip v1-skip" type="button" data-skip>{d.hero.skip}</button>
      </section>
    </template>

    <!-- ===================== Вариант 2. Схема ===================== -->
    <template id="tpl-2">
      <section class="v2 hero" data-variant="2">
        <header class="v2-top">
          <a class="v2-logo" href="#"><span class="v2-dot"></span>{d.hero.nick}</a>
          <nav class="v2-nav">{nav.map((n) => <a href="#">{n}</a>)}</nav>
          <a class="v2-lang" href="#" title={d.nav.langSwitchTitle}>{d.nav.langSwitch}</a>
        </header>
        <div class="v2-board">
          <div class="v2-typing brief-box" aria-hidden="true">
            <div class="v2-file">{d.hero.fileName}</div>
            <div class="brief-lines v2-lines" data-lines></div>
          </div>
          <div class="v2-final hero-final">
            <svg class="v2-wires" aria-hidden="true"></svg>
            <div class="v2-block v2-block-name" data-target="name">
              <h1>Савелий<br />Лопатин</h1>
              <span class="v2-port v2-port-r"></span>
              <span class="v2-port v2-port-b"></span>
            </div>
            <div class="v2-block v2-block-tag" data-target="do">
              <span class="v2-port v2-port-l"></span>
              <p>{d.hero.tagline}</p>
            </div>
            <div class="v2-block v2-block-who" data-target="who">
              <span class="v2-port v2-port-t"></span>
              <span class="v2-chip">заказчикам</span><span class="v2-chip">работодателям</span>
            </div>
            <a class="v2-block v2-btn" href="#" data-target="contact"><span class="v2-port v2-port-t"></span>{d.hero.ctaTelegram}</a>
            <a class="v2-works" href="#" data-target="main">{d.hero.ctaWorks} <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <button class="skip v2-skip" type="button" data-skip>{d.hero.skip}</button>
      </section>
    </template>

    <!-- ===================== Вариант 3. Линия ===================== -->
    <template id="tpl-3">
      <section class="v3 hero" data-variant="3">
        <header class="v3-top">
          <a class="v3-logo" href="#">{d.hero.nick}</a>
          <nav class="v3-nav">{nav.map((n, i) => <a href="#"><i class={`v3-c${i}`}></i>{n}</a>)}</nav>
          <a class="v3-lang" href="#" title={d.nav.langSwitchTitle}>{d.nav.langSwitch}</a>
        </header>
        <div class="v3-map brief-box" aria-hidden="true">
          <div class="v3-rail"><i></i></div>
          <div class="brief-lines v3-lines" data-lines></div>
        </div>
        <div class="v3-final hero-final">
          <div class="v3-plate" data-target="name">
            <span class="v3-stripe"></span>
            <h1>Савелий Лопатин</h1>
            <div class="v3-dirs"><span>← заказчикам</span><span>работодателям →</span></div>
          </div>
          <div class="v3-side">
            <p class="v3-tag" data-target="do">{d.hero.tagline}</p>
            <p class="v3-meta" data-target="who">Москва, работаю удалённо</p>
            <div class="v3-cta">
              <a class="v3-exit" href="#" data-target="contact"><span class="v3-exit-mark">⇥</span>{d.hero.ctaTelegram}</a>
              <a class="v3-next" href="#" data-target="main">{d.hero.ctaWorks}</a>
            </div>
          </div>
        </div>
        <button class="skip v3-skip" type="button" data-skip>{d.hero.skip}</button>
      </section>
    </template>

    <script>
      import { gsap } from 'gsap';
            import { SplitText } from 'gsap/SplitText';
      gsap.registerPlugin(SplitText);

      const BRIEF = JSON.parse(document.getElementById('brief-json')!.textContent!) as { id: string; text: string }[];
      const TYPO = JSON.parse(document.getElementById('typo-json')!.textContent!) as { line: number; wrong: string; right: string };
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isPhone = () => innerWidth < 760;

      /* ---------- печать брифа ---------- */
      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
      function typeLines(root: HTMLElement, lines: typeof BRIEF, opts: { cps: number; signal: { stop: boolean } }) {
        root.innerHTML = '';
        const els = lines.map((l) => {
          const div = document.createElement('div');
          div.className = 'brief-line';
          div.dataset.id = l.id;
          div.innerHTML = '<span class="brief-txt"></span>';
          root.appendChild(div);
          return div;
        });
        const delay = () => 1000 / opts.cps * (0.6 + Math.random() * 0.9);
        return (async () => {
          for (let i = 0; i < lines.length; i++) {
            const el = els[i];
            const txt = el.querySelector('.brief-txt') as HTMLElement;
            el.classList.add('is-active');
            els[i - 1]?.classList.remove('is-active');
            let target = lines[i].text;
            if (TYPO.line === i && target.startsWith(TYPO.right)) {
              // печатаем ошибочный вариант, стираем его, печатаем правильный
              for (const ch of TYPO.wrong) { if (opts.signal.stop) return els; txt.textContent += ch; await sleep(delay()); }
              await sleep(200);
              while (txt.textContent!.length > 0) { if (opts.signal.stop) return els; txt.textContent = txt.textContent!.slice(0, -1); await sleep(16); }
            }
            for (const ch of target) { if (opts.signal.stop) return els; txt.textContent += ch; await sleep(ch === ' ' ? delay() * 0.5 : delay()); }
            await sleep(90);
          }
          els[els.length - 1].classList.remove('is-active');
          return els;
        })();
      }

      /* ---------- превращение строк в элементы ---------- */
      function morph(hero: HTMLElement, lineEls: HTMLElement[], extra?: (tl: gsap.core.Timeline) => void) {
        const tl = gsap.timeline({ defaults: { ease: 'expo.inOut' } });
        const targets = hero.querySelectorAll<HTMLElement>('[data-target]');
        hero.classList.add('is-morphing');
        let k = 0;
        for (const line of lineEls) {
          const id = line.dataset.id!;
          const target = hero.querySelector<HTMLElement>(`[data-target="${id}"]`);
          if (!target) continue;
          let mover: HTMLElement = line;
          if (id === 'main') {
            // из строки «главное: показать…» в кнопку «Работы» улетает одно слово
            const txt = line.querySelector('.brief-txt') as HTMLElement;
            const split = new SplitText(txt, { type: 'words' });
            const w = split.words.find((x) => /показ/i.test(x.textContent || '')) as HTMLElement;
            mover = w || line;
            gsap.to(split.words.filter((x) => x !== mover), { opacity: 0, duration: 0.3 }, 0.1);
          }
          const at = 0.1 + k * 0.07;
          // строка летит к месту элемента и равномерно растёт, элемент проявляется ей навстречу
          gsap.set(mover, { x: 0, y: 0, scale: 1, transformOrigin: '0 0', willChange: 'transform' });
          const mr = mover.getBoundingClientRect();
          const tr = target.getBoundingClientRect();
          const scale = Math.min(3.2, Math.max(1, tr.height / mr.height));
          tl.to(mover, { x: tr.left - mr.left, y: tr.top - mr.top, scale, duration: 0.8, ease: 'expo.inOut' }, at);
          tl.to(mover, { opacity: 0, duration: 0.22, ease: 'power1.in' }, at + 0.55);
          tl.fromTo(target, { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out', clearProps: 'transform' }, at + 0.42);
          k++;
        }
        // всё остальное на экране просто проявляется
        const rest = [...hero.querySelectorAll<HTMLElement>('.hero-final > *:not([data-target]):not(.v3-side), .hero-final .v1-cta > *:not([data-target]), .hero-final .v3-side > *:not([data-target]), .hero-final .v3-cta > *:not([data-target])')];
        tl.fromTo(rest, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.6, stagger: 0.05, ease: 'power3.out', clearProps: 'transform' }, 0.7);
        extra?.(tl);
        tl.call(() => { hero.classList.remove('is-morphing', 'is-intro'); hero.classList.add('is-done'); gsap.set(targets, { clearProps: 'all' }); }, [], '>');
        return tl;
      }

      function finishNow(hero: HTMLElement) {
        hero.classList.add('is-done');
        hero.classList.remove('is-intro', 'is-morphing');
        gsap.set(hero.querySelectorAll('.hero-final, .hero-final *'), { clearProps: 'all' });
      }

      /* ---------- вариант 1: чертёж ---------- */
      function measure(hero: HTMLElement) {
        const name = hero.querySelector('.v1-name') as HTMLElement;
        const r = name.getBoundingClientRect();
        const fmt = (n: number) => Math.round(n).toLocaleString('ru-RU') + ' px';
        (hero.querySelector('[data-dim="w"]') as HTMLElement).textContent = fmt(r.width);
        (hero.querySelector('[data-dim="h"]') as HTMLElement).textContent = fmt(r.height);
        const dh = hero.querySelector('.v1-dim-h') as HTMLElement;
        const dv = hero.querySelector('.v1-dim-v') as HTMLElement;
        const hr = (hero.querySelector('.v1-final') as HTMLElement).getBoundingClientRect();
        dh.style.left = r.left - hr.left + 'px'; dh.style.width = r.width + 'px'; dh.style.top = r.top - hr.top - 22 + 'px';
        dv.style.top = r.top - hr.top + 'px'; dv.style.height = r.height + 'px'; dv.style.left = r.right - hr.left + 14 + 'px';
      }
      function runV1(hero: HTMLElement, sig: { stop: boolean }) {
        measure(hero);
        addEventListener('resize', () => measure(hero));
        const linesRoot = hero.querySelector('[data-lines]') as HTMLElement;
        const lines = isPhone() ? BRIEF.filter((l) => l.id !== 'who') : BRIEF;
        hero.classList.add('is-intro');
        typeLines(linesRoot, lines, { cps: isPhone() ? 110 : 95, signal: sig }).then((els) => {
          if (sig.stop) return;
          morph(hero, els as HTMLElement[], (tl) => {
            tl.fromTo('.v1-dim-h i', { scaleX: 0, transformOrigin: '0 50%' }, { scaleX: 1, duration: 0.7, ease: 'expo.out' }, 1.0);
            tl.fromTo('.v1-dim-v i', { scaleY: 0, transformOrigin: '50% 0' }, { scaleY: 1, duration: 0.7, ease: 'expo.out' }, 1.1);
            tl.fromTo('.v1-stamp-row', { opacity: 0, x: 12 }, { opacity: 1, x: 0, duration: 0.5, stagger: 0.06, ease: 'power3.out' }, 1.1);
            tl.fromTo('.v1-callout', { scale: 0.6, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.6, ease: 'back.out(1.8)' }, 1.3);
          });
        });
      }

      /* ---------- вариант 2: схема ---------- */
      function drawWires(hero: HTMLElement) {
        const svg = hero.querySelector('.v2-wires') as SVGSVGElement;
        const board = hero.querySelector('.v2-final') as HTMLElement;
        const br = board.getBoundingClientRect();
        svg.setAttribute('viewBox', `0 0 ${br.width} ${br.height}`);
        svg.innerHTML = '';
        const port = (sel: string) => { const p = hero.querySelector(sel)!.getBoundingClientRect(); return { x: p.left + p.width / 2 - br.left, y: p.top + p.height / 2 - br.top }; };
        const pairs = isPhone()
          ? [['.v2-block-name .v2-port-b', '.v2-block-tag .v2-port-l'], ['.v2-block-name .v2-port-b', '.v2-block-who .v2-port-t'], ['.v2-block-name .v2-port-b', '.v2-btn .v2-port-t']]
          : [['.v2-block-name .v2-port-r', '.v2-block-tag .v2-port-l'], ['.v2-block-name .v2-port-b', '.v2-block-who .v2-port-t'], ['.v2-block-tag .v2-port-l', '.v2-btn .v2-port-t']];
        for (const [a, b] of pairs) {
          const A = port(a), B = port(b);
          const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          const mx = (A.x + B.x) / 2;
          const dstr = Math.abs(A.y - B.y) < 4 ? `M${A.x},${A.y} L${B.x},${B.y}` : (Math.abs(A.x - B.x) < 4 ? `M${A.x},${A.y} L${B.x},${B.y}` : `M${A.x},${A.y} L${mx},${A.y} L${mx},${B.y} L${B.x},${B.y}`);
          path.setAttribute('d', dstr);
          path.setAttribute('pathLength', '1');
          svg.appendChild(path);
        }
        return svg.querySelectorAll('path');
      }
      function runV2(hero: HTMLElement, sig: { stop: boolean }) {
        const linesRoot = hero.querySelector('[data-lines]') as HTMLElement;
        const lines = isPhone() ? BRIEF.filter((l) => l.id !== 'who') : BRIEF;
        hero.classList.add('is-intro');
        const paths = drawWires(hero);
        gsap.set(paths, { strokeDasharray: 1, strokeDashoffset: 1 });
        typeLines(linesRoot, lines, { cps: isPhone() ? 110 : 95, signal: sig }).then((els) => {
          if (sig.stop) return;
          morph(hero, els as HTMLElement[], (tl) => {
            tl.to(paths, { strokeDashoffset: 0, duration: 0.8, stagger: 0.12, ease: 'power2.inOut' }, 1.0);
            tl.fromTo('.v2-port', { scale: 0 }, { scale: 1, duration: 0.4, stagger: 0.04, ease: 'back.out(2)' }, 1.0);
          });
        });
      }

      /* ---------- вариант 3: линия ---------- */
      function runV3(hero: HTMLElement, sig: { stop: boolean }) {
        const linesRoot = hero.querySelector('[data-lines]') as HTMLElement;
        const lines = isPhone() ? BRIEF.filter((l) => l.id !== 'who') : BRIEF;
        hero.classList.add('is-intro');
        const rail = hero.querySelector('.v3-rail i') as HTMLElement;
        gsap.fromTo(rail, { scaleY: 0, transformOrigin: '50% 0' }, { scaleY: 1, duration: lines.length * 0.75, ease: 'none' });
        typeLines(linesRoot, lines, { cps: isPhone() ? 110 : 95, signal: sig }).then((els) => {
          if (sig.stop) return;
          morph(hero, els as HTMLElement[], (tl) => {
            tl.fromTo('.v3-stripe', { scaleX: 0, transformOrigin: '0 50%' }, { scaleX: 1, duration: 0.7, ease: 'expo.out' }, 0.9);
            tl.to(rail, { scaleY: 0, transformOrigin: '50% 100%', duration: 0.5, ease: 'power2.in' }, 0.4);
          });
        });
      }

      const RUN = [runV1, runV2, runV3];

      /* ---------- harness (picker) ---------- */
      const stage = document.getElementById('stage')!;
      const picker = document.querySelector('.proto-picker')!;
      const highlight = picker.querySelector('.proto-picker-highlight') as HTMLElement;
      const items = [...picker.querySelectorAll('.proto-picker-item:not(.proto-picker-replay)')] as HTMLElement[];
      const replay = picker.querySelector('.proto-picker-replay');
      let current = 0;
      let sig = { stop: false };
      const variants = [1, 2, 3].map((n) => () => (document.getElementById(`tpl-${n}`) as HTMLTemplateElement).innerHTML);

      function moveHighlight() {
        const el = items[current];
        highlight.style.width = el.offsetWidth + 'px';
        highlight.style.transform = `translateX(${el.offsetLeft}px)`;
      }
      function mount(i: number) {
        sig.stop = true; sig = { stop: false };
        gsap.globalTimeline.clear();
        stage.innerHTML = '';
        requestAnimationFrame(() => {
          stage.innerHTML = variants[i]();
          const hero = stage.querySelector('.hero') as HTMLElement;
          const mySig = sig;
          hero.querySelector('[data-skip]')?.addEventListener('click', () => { mySig.stop = true; gsap.globalTimeline.clear(); finishNow(hero); });
          if (reduced) { finishNow(hero); if (i === 0) measure(hero); if (i === 1) drawWires(hero); return; }
          document.fonts.ready.then(() => { if (!mySig.stop) RUN[i](hero, mySig); });
        });
      }
      function setActive(i: number) {
        if (i < 0 || i >= variants.length) return;
        current = i;
        items.forEach((el, j) => {
          el.toggleAttribute('data-active', j === i);
          if (j === i) el.setAttribute('aria-current', 'true'); else el.removeAttribute('aria-current');
        });
        moveHighlight();
        const url = new URL(location.href);
        url.searchParams.set('v', String(i + 1));
        history.replaceState(null, '', url);
        mount(i);
      }
      items.forEach((el, i) => el.addEventListener('click', () => setActive(i)));
      replay?.addEventListener('click', () => mount(current));
      window.addEventListener('resize', moveHighlight);
      document.addEventListener('keydown', (e) => {
        const t = e.target as HTMLElement;
        if (/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable) return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const num = parseInt(e.key, 10);
        if (num >= 1 && num <= variants.length) setActive(num - 1);
        else if (e.key === 'ArrowRight') setActive((current + 1) % variants.length);
        else if (e.key === 'ArrowLeft') setActive((current - 1 + variants.length) % variants.length);
        else if (e.key === 'r' || e.key === 'R') mount(current);
      });
      setActive((parseInt(new URLSearchParams(location.search).get('v') || '', 10) || 1) - 1);
      requestAnimationFrame(() => requestAnimationFrame(() => picker.setAttribute('data-ready', '')));
    </script>
    <script is:inline type="application/json" id="brief-json" set:html={JSON.stringify(brief)} />
    <script is:inline type="application/json" id="typo-json" set:html={JSON.stringify(d.hero.typo)} />
  </body>
</html>

<style is:global>
  /* ---- picker: спецификация, не менять ---- */
  .proto-picker{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:2147483647;display:flex;align-items:center;gap:2px;padding:4px;border-radius:999px;background:rgba(10,10,10,.82);-webkit-backdrop-filter:blur(12px) saturate(1.4);backdrop-filter:blur(12px) saturate(1.4);box-shadow:0 0 0 1px rgba(255,255,255,.08) inset,0 8px 24px rgba(0,0,0,.24),0 2px 6px rgba(0,0,0,.12);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:13px;line-height:1;-webkit-font-smoothing:antialiased;user-select:none;-webkit-user-select:none}
  .proto-picker-highlight{position:absolute;top:4px;left:0;height:28px;border-radius:999px;background:rgba(255,255,255,.12);will-change:transform}
  .proto-picker[data-ready] .proto-picker-highlight{transition:transform 250ms cubic-bezier(.23,1,.32,1),width 250ms cubic-bezier(.23,1,.32,1)}
  @media (prefers-reduced-motion:reduce){.proto-picker[data-ready] .proto-picker-highlight{transition:none}}
  .proto-picker-item{position:relative;display:flex;align-items:center;height:28px;padding:0 12px;border:0;border-radius:999px;background:transparent;color:rgba(255,255,255,.55);font:inherit;cursor:pointer;transition:color 150ms ease-out}
  .proto-picker-item:hover{color:rgba(255,255,255,.85)}
  .proto-picker-item:active{transform:scale(.97)}
  .proto-picker-item:focus-visible{outline:2px solid rgba(255,255,255,.4);outline-offset:2px}
  .proto-picker-item[data-active]{color:#fff}
  .proto-picker-divider{width:1px;height:16px;margin:0 4px;background:rgba(255,255,255,.12)}
  .proto-picker-replay{padding:0 10px;font-size:14px}
  .proto-picker[data-position="top"]{bottom:auto;top:24px}

  /* ---- общее ---- */
  *,*::before,*::after{box-sizing:border-box}
  html,body{margin:0;min-height:100%}
  body{background:#111;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
