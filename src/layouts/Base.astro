---
import { ClientRouter } from 'astro:transitions';
import '../styles/fonts.generated.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/sections.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, langPrefix, langs, type Lang } from '../i18n';
import { site } from '../config';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Путь страницы без языкового префикса и без base, например '/' или '/work/aroma-forge/'. */
  path: string;
  ogImage?: string;
  noindex?: boolean;
  theme?: string;
}
const { lang, path, noindex = false, theme = 'black' } = Astro.props;
const d = t(lang);
const title = Astro.props.title ?? d.meta.title;
const description = Astro.props.description ?? d.meta.description;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = Astro.site ? Astro.site.origin : '';
const url = (l: Lang, p: string) => `${origin}${base}${langPrefix(l)}${p}`;
const canonical = url(lang, path);
const ogImage = `${origin}${base}${Astro.props.ogImage ?? (lang === 'en' ? '/og-en.png' : '/og.png')}`;
const other = lang === 'ru' ? 'en' : 'ru';
---
<!doctype html>
<html lang={d.htmlLang} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l === 'ru' ? 'ru' : 'en'} href={url(l, path)} />)}
    <link rel="alternate" hreflang="x-default" href={url('ru', path)} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="d1fast" />
    <meta property="og:title" content={Astro.props.title ?? d.meta.ogTitle} />
    <meta property="og:description" content={Astro.props.description ?? d.meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={other === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link rel="preload" href={`${base}/fonts/unbounded-cyr.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/golos-cyr.woff2`} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { if (sessionStorage.getItem('intro-seen')) document.documentElement.classList.add('intro-seen'); } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: lang === 'ru' ? 'Савелий Лопатин' : 'Saveliy Lopatin',
      alternateName: 'd1fast',
      url: url(lang, '/'),
      email: site.email,
      jobTitle: lang === 'ru' ? 'Веб-разработчик' : 'Web developer',
      address: { '@type': 'PostalAddress', addressLocality: lang === 'ru' ? 'Москва' : 'Moscow', addressCountry: 'RU' },
      sameAs: [site.telegramUrl],
    })} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">{d.nav.skipToContent}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <div class="easter" data-easter data-lines={JSON.stringify(d.easter.lines)} hidden role="dialog" aria-modal="true" aria-label={d.easter.title}>
      <div class="easter__sheet">
        <div class="easter__head"><span class="easter__file">{d.easter.title}</span><button class="easter__close" type="button" data-easter-close>{d.easter.close}</button></div>
        <div class="brief-lines" data-easter-lines></div>
      </div>
    </div>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
