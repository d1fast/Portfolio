---
// Рамка чертёжного листа с угловыми метками и штампом. Линии рамки рисуются при появлении раздела.
import type { Lang } from '../i18n';
interface Props { n: number; of: number; name: string; lang: Lang; class?: string }
const { n, of, name, lang, class: cls = '' } = Astro.props;
const labels = lang === 'ru'
  ? { sheet: 'Лист', sheets: 'Листов', dev: 'Разраб.', who: 'Лопатин С.', name: 'Наим.', date: 'Дата' }
  : { sheet: 'Sheet', sheets: 'Sheets', dev: 'Drawn by', who: 'S. Lopatin', name: 'Title', date: 'Date' };
---
<div class={`sheet ${cls}`} aria-hidden="true" data-sheet>
  <i class="sheet__l sheet__l--t"></i><i class="sheet__l sheet__l--r"></i><i class="sheet__l sheet__l--b"></i><i class="sheet__l sheet__l--l"></i>
  <i class="sheet__c sheet__c--tl"></i><i class="sheet__c sheet__c--tr"></i><i class="sheet__c sheet__c--bl"></i><i class="sheet__c sheet__c--br"></i>
  <div class="stamp" data-stamp>
    <span class="stamp__cell"><b>{labels.name}</b>{name}</span>
    <span class="stamp__cell"><b>{labels.dev}</b>{labels.who}</span>
    <span class="stamp__cell"><b>{labels.sheet}</b>{n}<em>/</em>{of}</span>
    <span class="stamp__cell stamp__cell--date"><b>{labels.date}</b><span data-stamp-date>10.2026</span></span>
  </div>
</div>
