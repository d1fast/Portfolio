---
// Первый экран. Имя собирают тысячи знаков (hero.ts + glyphs.ts, WebGL). Настоящий заголовок лежит в HTML:
// по нему считаются места знаков, его читают скринридеры и поисковики, без WebGL он просто виден.
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const [first, last] = d.hero.name.split(' ');
---
<section class="block hero" id="top" data-theme="hero" data-block="hero" data-hero>
  <canvas class="hero__gl" aria-hidden="true" data-hero-gl></canvas>
  <div class="container hero__final">
    <h1 class="hero__name" data-hero-name><span class="hero__line hero__line--1" data-hero-line>{first}</span> <span class="hero__line hero__line--2" data-hero-line>{last}</span></h1>
    <div class="hero__side">
      <p class="hero__tag" data-hero-tag>{d.hero.tagline}</p>
      <div class="hero__cta" data-hero-cta>
        <a class="btn btn--primary" href="#contacts" data-magnetic>{d.hero.ctaContact}</a>
        <a class="btn btn--ghost" href="#works" data-magnetic="0.2">{d.hero.ctaWorks}</a>
      </div>
    </div>
  </div>
</section>
