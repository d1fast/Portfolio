---
import { t, langPrefix, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<article class="policy container">
  <h1 class="policy__title">{d.policy.title}</h1>
  <p class="policy__date">{d.policy.updated}</p>
  <div class="policy__body">{d.policy.body.map((p) => <p>{p}</p>)}</div>
  <a class="policy__back" href={`${base}${langPrefix(lang)}/`}>← {d.policy.back}</a>
</article>
