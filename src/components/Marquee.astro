---
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const words = lang === 'ru'
  ? ['сайты', '3D', 'небольшие игры', 'Telegram-боты', 'интерфейсы', 'ТЗ до первой строки кода', 'от идеи до запуска']
  : ['websites', '3D', 'small games', 'Telegram bots', 'interfaces', 'a spec before the first line of code', 'from idea to launch'];
const row = [...words, ...words];
---
<div class="marquee-wrap"><div class="marquee" data-marquee aria-hidden="true">
  <div class="marquee__track">
    {row.map((w) => <span class="marquee__item">{w}<i class="marquee__tick"></i></span>)}
  </div>
</div></div>
