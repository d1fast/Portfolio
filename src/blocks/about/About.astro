---
import './about.css';
import fs from 'node:fs';
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Фото: положить файл в public/photo/me.jpg (или .webp, .png), пропорция 4:5. Пока его нет, стоит заглушка.
const photo = ['me.webp', 'me.jpg', 'me.png'].find((f) => fs.existsSync(`public/photo/${f}`));
const ui = { ru: { hint: 'потаскай наклейки' }, en: { hint: 'drag the stickers' } }[lang];

// заголовок по буквам: первая буква курсивная, её обводит рука
const words = d.about.title.split(' ');
// в лиде ник выделен курсивом и подчёркнут от руки
const lead = d.about.lead;
const nick = d.hero.nick;
const at = lead.indexOf(nick);
const leadA = at >= 0 ? lead.slice(0, at) : lead;
const tail = at >= 0 ? lead.slice(at + nick.length) : '';
// знак после ника держится с ним на одной строке
const punct = tail.match(/^[^\s]*/)?.[0] ?? '';
const leadB = tail.slice(punct.length);
const initials = d.hero.name.split(/\s+/).map((w) => w[0]).join('');

// формы наклеек: фигурный круг, овал, звезда-ценник
const r2 = (n: number) => Math.round(n * 100) / 100;
const radial = (fn: (a: number, i: number) => number, steps: number) => {
  let p = '';
  for (let i = 0; i < steps; i++) {
    const a = (i / steps) * Math.PI * 2 - Math.PI / 2;
    const r = fn(a, i);
    p += (i ? 'L' : 'M') + r2(50 + Math.cos(a) * r) + ',' + r2(50 + Math.sin(a) * r);
  }
  return p + 'Z';
};
const scallop = radial((a) => 44 + 5 * Math.abs(Math.cos(a * 7)), 280);
const burst = radial((_a, i) => (i % 2 ? 41 : 49.5), 40);
const stickers = d.about.stickers.slice(0, 3).map((text, i) => ({ text, kind: ['scallop', 'oval', 'burst'][i], slot: i < 2 ? 'photo' : 'head' }));
---
<section class="block block--about about" id="about" data-theme="about" data-block="about">
  <div class="block__inner container about__grid">
    <div class="about__desk" data-about-desk aria-hidden="true"></div>

    <div class="about__photo">
      <div class="about__drop" data-about-drop>
        <div class="about__sway">
          <figure class="about__polaroid" data-about-swing>
            <span class="about__tape" data-about-tape aria-hidden="true"></span>
            <div class="about__pic">
              {photo ? (
                <img src={`${base}/photo/${photo}`} alt={d.about.photoAlt} width="800" height="1000" loading="lazy" decoding="async" />
              ) : (
                <div class="about__ph" role="img" aria-label={d.about.photoSoon}>
                  <span class="about__mono" aria-hidden="true">{initials}</span>
                  <span class="about__ph-note" aria-hidden="true">{d.about.photoSoon}</span>
                </div>
              )}
              <span class="about__dev" data-about-dev aria-hidden="true"></span>
            </div>
            <figcaption class="about__name"><span class="about__name-t" data-about-write>{d.hero.name}</span></figcaption>
          </figure>
        </div>
      </div>
      {stickers.filter((s) => s.slot === 'photo').map((s) => (
        <button type="button" class={`about__sticker about__sticker--${s.kind}`} data-about-sticker data-drag aria-describedby="about-hint">
          <span class="about__st-in">
            <span class="about__st-body">
              {s.kind === 'oval' ? (
                <svg class="about__st-shape" viewBox="0 0 100 62" aria-hidden="true"><ellipse class="about__st-shadow" cx="50" cy="31" rx="48" ry="29" /><ellipse class="about__st-fill" cx="50" cy="31" rx="48" ry="29" /><ellipse class="about__st-line" cx="50" cy="31" rx="43" ry="24.5" /></svg>
              ) : (
                <svg class="about__st-shape" viewBox="0 0 100 100" aria-hidden="true"><path class="about__st-shadow" d={scallop} /><path class="about__st-fill" d={scallop} /></svg>
              )}
              <span class="about__st-text">{s.text}</span>
            </span>
          </span>
        </button>
      ))}
    </div>

    <div class="about__text">
      <div class="about__head">
        <h2 class="block__title about__title" aria-label={d.about.title} data-about-title>
          {words.map((w, wi) => (
            <Fragment>
              {wi > 0 && ' '}
              <span class="about__w" aria-hidden="true">
                {wi === 0 ? (
                  <Fragment>
                    <span class="about__capbox"><span class="about__m"><span class="about__ch about__cap">{w.slice(0, 1)}</span></span><svg class="about__ring" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path data-about-ring d="M64,9 C34,1 7,22 7,52 C7,82 38,97 64,91 C90,85 98,60 93,38 C88,16 66,5 36,11" /></svg></span>
                    {w.length > 1 && <span class="about__m">{[...w.slice(1)].map((c) => <span class="about__ch">{c}</span>)}</span>}
                  </Fragment>
                ) : (
                  <span class="about__m">{[...w].map((c) => <span class="about__ch">{c}</span>)}</span>
                )}
              </span>
            </Fragment>
          ))}
        </h2>
        <p class="about__hint" id="about-hint"><span class="about__hint-t" data-about-hint>{ui.hint}</span><svg class="about__hint-arrow" viewBox="0 0 60 40" aria-hidden="true"><path data-about-hint-arrow d="M4,30 C14,12 32,4 52,12" /><path data-about-hint-arrow d="M52,12 L41,5 M52,12 L45,22" /></svg></p>
        {stickers.filter((s) => s.slot === 'head').map((s) => (
          <button type="button" class={`about__sticker about__sticker--${s.kind}`} data-about-sticker data-drag aria-describedby="about-hint">
            <span class="about__st-in">
              <span class="about__st-body">
                <svg class="about__st-shape" viewBox="0 0 100 100" aria-hidden="true"><path class="about__st-shadow" d={burst} /><path class="about__st-fill" d={burst} /></svg>
                <span class="about__st-text">{s.text}</span>
              </span>
            </span>
          </button>
        ))}
      </div>

      <div class="about__leadbox">
        <p class="about__lead" data-about-lead>{leadA}{at >= 0 && <span class="about__nickbox"><em class="about__nick">{nick}</em>{punct}</span>}{leadB}</p>
      </div>

      <ul class="about__notes">
        {d.about.notes.slice(0, 4).map((n, i) => (
          <li class={`about__note about__note--${i + 1}`} data-about-note-item>
            <span class="about__note-t" data-about-note>{n}</span>
            {i === 0 && (
              <Fragment>
                <svg class="about__doodle about__doodle--arrow" viewBox="0 0 100 60" aria-hidden="true"><path data-about-doodle d="M97,16 C80,4 58,8 55,25 C52,42 72,46 75,33 C78,20 58,17 40,26 C26,33 15,41 6,49" /><path data-about-doodle d="M6,49 L9,35 M6,49 L20,50" /></svg>
                <svg class="about__doodle about__doodle--star" viewBox="0 0 24 24" aria-hidden="true"><path data-about-doodle-alt d="M12,2 L12,22 M3,7 L21,17 M3,17 L21,7" /></svg>
              </Fragment>
            )}
            {i === 1 && <svg class="about__doodle about__doodle--wave" viewBox="0 0 200 16" preserveAspectRatio="none" aria-hidden="true"><path data-about-doodle d="M3,10 C18,4 30,14 46,8 C62,2 74,13 90,8 C106,3 118,13 134,8 C150,3 162,12 178,7 C186,5 192,6 197,8" /></svg>}
            {i === 2 && <svg class="about__doodle about__doodle--loop" viewBox="0 0 200 80" preserveAspectRatio="none" aria-hidden="true"><path data-about-doodle d="M42,11 C92,4 156,2 183,8 C202,14 201,58 189,69 C168,80 60,82 18,75 C0,70 -1,22 14,12 C28,5 62,3 98,6" /></svg>}
            {i === 3 && <svg class="about__doodle about__doodle--double" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"><path data-about-doodle d="M4,7 C50,3 120,4 196,6 M12,15 C70,12 128,13 186,15" /></svg>}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
