---
import './process.css';
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<section class="block block--process process" id="process" data-theme="process" data-block="process">
  <div class="block__inner container">
    <h2 class="block__title" data-reveal="lines">{d.process.title}</h2>
    <ol class="process__list" data-active-list data-reveal="stagger">
      {d.process.steps.map((s, i) => (
        <li class="process__step">
          <span class="process__num" aria-hidden="true">{i + 1}</span>
          <h3 class="process__name">{s.title}</h3>
          <p class="process__text">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
